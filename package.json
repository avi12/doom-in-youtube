{
  "name": "doom-in-youtube",
  "version": "0.1.1",
  "type": "module",
  "description": "Click the icon and every YouTube thumbnail becomes a peephole onto one live DOOM",
  "author": "Avi <avi6106@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/avi12/doom-in-youtube#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/doom-in-youtube.git"
  },
  "bugs": {
    "url": "https://github.com/avi12/doom-in-youtube/issues"
  },
  "keywords": [
    "doom",
    "youtube",
    "chrome-extension",
    "wxt",
    "js-dos",
    "manifest-v3"
  ],
  "imports": {
    "#imports": "./.wxt/types/imports-module.d.ts"
  },
  "scripts": {
    "ext:dev": "wxt",
    "ext:dev:edge": "wxt -b edge",
    "ext:build": "wxt build",
    "ext:zip": "wxt zip",
    "lint": "avi12-lint",
    "lint:fix": "avi12-lint --fix",
    "stylelint": "stylelint \"**/*.css\" --fix",
    "fallow": "fallow audit --base HEAD",
    "check": "tsgo --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "avi12-lint": "github:avi12/lint-config#v0.4.9&path:/packages/avi12-lint",
    "fallow": "2.103.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.9&path:/packages/fallow-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.9&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.9&path:/packages/oxlint-plugin-naming",
    "oxlint-tsgolint": "0.24.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.9&path:/packages/stylelint-config",
    "typescript": "6.0.3",
    "web-ext-run": "^0.2.4",
    "wxt": "^0.20.27"
  },
  "packageManager": "pnpm@11.1.2",
  "dependencies": {
    "@webext-core/messaging": "^3.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  }
}
