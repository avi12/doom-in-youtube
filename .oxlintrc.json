{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/oxlint-config-avi12/oxlint.json",
    "./node_modules/oxlint-plugin-naming/preset.json"
  ],
  "env": {
    "browser": true
  },
  "globals": {
    "browser": "readonly",
    "chrome": "readonly"
  },
  "rules": {
    "naming/convention": ["error", {
      "allowedNames": [
        { "reason": "The extension manifest spells these keys in snake_case", "names": ["default_title", "host_permissions", "web_accessible_resources", "content_security_policy", "extension_pages"] },
        { "reason": "js-dos declares its global constructor as Dos", "names": ["Dos"] },
        { "reason": "Message names are PascalCase keys of the messaging enums", "names": ["ToggleDoom", "DoomReady"] }
      ]
    }],
    "no-restricted-globals": ["error", { "name": "process", "message": "Extension code does not run under Node, read config through import.meta.env" }],
    "typescript/unbound-method": "off",
    "typescript/await-thenable": "off",
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off"
  },
  "overrides": [
    {
      "files": ["src/entrypoints/**/*.ts"],
      "rules": { "no-restricted-exports": "off" }
    },
    {
      "files": ["./scripts/*.ts", "**/*.config.ts", "**/*.config.js", "**/*.config.mjs"],
      "env": { "node": true },
      "rules": { "no-restricted-globals": "off" }
    }
  ],
  "ignorePatterns": [".output/**", ".wxt/**", "src/public/**"]
}
